# Alpha Planner — environment variables
#
# Copy this file to `.env` and fill in the values you need:
#
#   cp .env.example .env
#
# BOTH variables below are OPTIONAL. Alpha Planner is local-first and works
# fully offline without an account. Experimental cloud sync stays OFF unless
# BOTH values are set; leave them empty to keep the app on-device only.
# See supabase/README.md for how to set up your own backend.
#
# Only the anon / publishable key belongs here. Never put a service_role
# (secret) key in this file: EXPO_PUBLIC_* values are inlined into the app
# bundle and can be extracted by anyone who installs the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
